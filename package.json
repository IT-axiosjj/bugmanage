{
  "name": "taskdock",
  "version": "0.1.0",
  "description": "TaskDock：面向程序员的 Windows 桌面悬浮任务清单，支持项目分类、优先级、勾选完成及文档/OCR 导入。",
  "main": "electron/main.cjs",
  "author": "TaskDock",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.taskdock.desktop",
    "productName": "TaskDock",
    "artifactName": "TaskDock-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TaskDock",
      "runAfterFinish": true
    },
    "compression": "maximum"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-axiosjj/bugmanage.git"
  },
  "homepage": "https://github.com/IT-axiosjj/bugmanage#readme",
  "bugs": {
    "url": "https://github.com/IT-axiosjj/bugmanage/issues"
  }
}
